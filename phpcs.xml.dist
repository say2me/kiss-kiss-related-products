<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="vscm" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/squizlabs/PHP_CodeSniffer/master/phpcs.xsd">

	<description>Vscm product</description>
	<file>.</file>
	<!-- Exclude  -->
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>*.min.js</exclude-pattern>
	<exclude-pattern>/index.php</exclude-pattern>

	<arg value="sp" /> <!-- Show sniff and progress -->
	<arg name="colors" /> <!-- Show results with colors. Disable if working on Windows -->
	<arg name="basepath" value="." /> <!-- Strip the file paths down to the relevant bit -->
	<arg name="parallel" value="8" /> 
	<arg name="extensions" value="php" /> <!-- Limit to PHP files -->
	
	<rule ref="WordPress">
		<exclude name="Generic.Arrays.DisallowShortArraySyntax" />
		<exclude name="PSR2.Classes.PropertyDeclaration.Underscore" />
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase" />
	</rule>

	<config name="testVersion" value="8.1-"/>
	<rule ref="PHPCompatibilityWP"/>

	<config name="minimum_supported_wp_version" value="6.3"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="vscm"/>
			</property>
		</properties>
	</rule>

</ruleset>
